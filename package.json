{
  "name": "usewagen",
  "version": "0.0.0",
  "description": "Type-safe composables to sync Vue state with router and storage.",
  "homepage": "https://github.com/tinas/usewagen#readme",
  "bugs": {
    "url": "https://github.com/tinas/usewagen/issues"
  },
  "license": "MIT",
  "author": "Ahmet Tinastepe <ahmettinastepe0@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinas/usewagen.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./vite": "./dist/vite/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "lint:fix": "vp lint --fix && vp fmt",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  }
}
