{
  "name": "usewagen",
  "version": "0.0.0",
  "description": "Type-safe composables to sync Vue state with router and storage.",
  "homepage": "https://github.com/tinas/usewagen#readme",
  "bugs": {
    "url": "https://github.com/tinas/usewagen/issues"
  },
  "license": "MIT",
  "author": "Ahmet Tinastepe <ahmettinastepe0@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinas/usewagen.git"
  },
  "files": [
    "client.d.ts",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./registry": "./dist/registry.mjs",
    "./router": "./dist/router/index.mjs",
    "./storage": "./dist/storage/index.mjs",
    "./vite": "./dist/vite/index.mjs",
    "./package.json": "./package.json",
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "lint:fix": "vp lint --fix && vp fmt",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "vite": "^7.3.0 || ^8.0.0",
    "vue": "^3.5.0 || ^4.0.0",
    "vue-router": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  }
}
